# Copy this file to .env and fill in your values. Never commit the real .env.

# Which LLM cleans up the raw transcript into a summary: "claude" (default,
# hosted, needs ANTHROPIC_API_KEY) or "ollama" (local model on your own server,
# no API key or per-request cost, but quality depends on the model you run).
LLM_PROVIDER=claude

# Required if LLM_PROVIDER=claude: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Used if LLM_PROVIDER=ollama: base URL of your Ollama server and the model
# to use (must already be pulled there, e.g. `ollama pull llama3.1`).
OLLAMA_URL=http://savage.local:11434
OLLAMA_MODEL=llama3.1

# Required: dashboard login (protects the web UI - viewing/editing transcripts,
# the record button, admin actions). The server refuses to start without these.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Required: long random token the ESP32 device must send to POST /upload.
# This is separate from the dashboard login since the device can't do a
# browser login flow. Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must match UPLOAD_TOKEN in firmware/src/config.h.
UPLOAD_TOKEN=

# Required if the site is reachable over the public internet: a long random
# string used to sign session cookies. Generate one the same way as UPLOAD_TOKEN.
FLASK_SECRET_KEY=

# Set to true once this app is served over HTTPS via a reverse proxy - makes
# session cookies HTTPS-only and enables HSTS. Leave false for local http:// testing.
BEHIND_HTTPS_PROXY=false

# Where to save/upload from the device (default is fine)
UPLOAD_PORT=8787
OUTPUT_DIR=./transcripts

# Whisper model size for local transcription: tiny, base, small, medium, large-v3
# Bigger = more accurate, slower, more RAM. "small" is a reasonable default
# for meeting audio on a laptop CPU.
WHISPER_MODEL=small

# Set to "cuda" to run Whisper on an NVIDIA GPU (requires nvidia-container-toolkit
# on the Docker host and the GPU reservation in docker-compose.yml). Leave "cpu"
# otherwise. WHISPER_COMPUTE_TYPE defaults to int8 on cpu and float16 on cuda;
# override only if you know you want a different precision/speed tradeoff.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=

# Optional: email the finished transcript instead of / in addition to saving it.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
