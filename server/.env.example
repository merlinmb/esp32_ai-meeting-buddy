# Copy this file to .env and fill in your values. Never commit the real .env.

# Required: Claude API key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Where to save/upload from the device (default is fine)
UPLOAD_PORT=8787
OUTPUT_DIR=./transcripts

# Whisper model size for local transcription: tiny, base, small, medium, large-v3
# Bigger = more accurate, slower, more RAM. "small" is a reasonable default
# for meeting audio on a laptop CPU.
WHISPER_MODEL=small

# Optional: email the finished transcript instead of / in addition to saving it.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
