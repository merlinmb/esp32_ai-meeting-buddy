#pragma once
// User-editable settings.

// ---- WiFi -------------------------------------------------------------
#define WIFI_SSID      "your-wifi-name"
#define WIFI_PASSWORD  "your-wifi-password"
#define WIFI_CONNECT_TIMEOUT_MS  15000


// ---- Companion receiver server ----------------------------------------
// Where the device uploads finished recordings. This points at the Docker
// deployment on savage.local (see server/deploy.sh). arduino-esp32 generally
// resolves "*.local" mDNS hostnames out of the box, but mDNS reliability
// varies by router/network - if the device can't resolve it, replace this
// with savage.local's plain IP address instead (find it with `ping
// savage.local` from another machine on the same network, or check your
// router's client list).
#define UPLOAD_SERVER_URL  "http://savage.local:8787/upload"

// ---- Audio --------------------------------------------------------------
#define SAMPLE_RATE_HZ   16000   // 16kHz mono is plenty for speech and keeps files small
#define SAMPLE_BITS      16
#define AUDIO_CHANNELS   1

// ---- Behavior -----------------------------------------------------------
// Uploads run on their own FreeRTOS task (see upload_worker.h) rather than
// inline in loop(), so a multi-hour upload never delays button polling or
// LCD redraws. AUTO_UPLOAD_WHEN_IDLE (if true) makes that task retry
// pending recordings on its own roughly every UPLOAD_RETRY_INTERVAL_MS
// whenever nothing is recording - it doesn't wait for the idle *screen*
// specifically, just for recording to stop, so it keeps working quietly
// even while you're in the menu. If false, uploads only ever happen when
// you pick "Upload now" from the menu.
#define AUTO_UPLOAD_WHEN_IDLE  true
#define UPLOAD_RETRY_INTERVAL_MS  (5UL * 60UL * 1000UL)  // don't hammer WiFi if the server is unreachable

// Stack for the background upload task. It uses String/WiFiClient and a
// 1KB read buffer, so give it real headroom - bump this if you ever see a
// stack overflow panic naming "uploadWorker".
#define UPLOAD_WORKER_STACK_BYTES  8192

// Uploads are resumable: each file is sent as a series of UPLOAD_CHUNK_BYTES
// POSTs, and before (re)starting a file the device asks the server how many
// bytes it already has (GET .../status) and resumes from there. That means a
// meeting recording that's 2+ hours (100+ MB) doesn't have to restart from
// byte 0 after a WiFi hiccup, a reboot, or the next periodic retry - only
// the chunk(s) that didn't land need resending.
//
// Every blocking network wait a single chunk does is capped by one of
// these, so a stalled/slow link fails fast instead of hanging loop() long
// enough to trip the watchdog:
//   - UPLOAD_SOCKET_TIMEOUT_MS   bounds the TCP connect and the final wait
//                                for the server's HTTP response.
//   - UPLOAD_STALL_TIMEOUT_MS    bounds time with NO forward progress while
//                                streaming one chunk's body - it resets
//                                after every buffer written, so a chunk
//                                that's still moving data is never cut off.
// UPLOAD_MAX_RETRIES is how many *consecutive* chunk failures a file's
// upload tolerates before this pass gives up on it (leaving it pending for
// the next automatic pass or "Upload now" from the menu) - since a retry
// only costs one chunk (not the whole file), this doesn't need to be
// generous. It's also what a recording button-press looks like from the
// uploader's point of view: shouldAbort() firing bypasses this count
// entirely and just parks the worker, it's never treated as a failure.
#define UPLOAD_CHUNK_BYTES        262144UL   // 256 KB per chunk POST
#define UPLOAD_SOCKET_TIMEOUT_MS  15000
#define UPLOAD_STALL_TIMEOUT_MS   15000
#define UPLOAD_MAX_RETRIES        3
#define UPLOAD_RETRY_BACKOFF_MS   2000

// ---- Menu ---------------------------------------------------------------
#define MENU_IDLE_TIMEOUT_MS  (8UL * 1000UL)   // auto-return to idle if the menu sits untouched this long
#define DEVICE_VERSION  "0.2"
