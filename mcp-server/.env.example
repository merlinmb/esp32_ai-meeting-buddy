# Copy to .env and fill in. Never commit the real .env.

# Base URL of the AI Meeting Buddy server (no trailing slash)
MEETING_BUDDY_URL=https://notes.example.com

# Required: read-only token for list_todos/get_stats. Use TODOS_READ_TOKEN
# from server/.env (safest), or UPLOAD_TOKEN if TODOS_READ_TOKEN isn't set.
MEETING_BUDDY_READ_TOKEN=

# Optional: UPLOAD_TOKEN from server/.env, needed only for mark_todo_done.
# Leave blank if you only want read access (list_todos, get_stats) and
# don't want this MCP server able to change anything.
MEETING_BUDDY_WRITE_TOKEN=

# Only used by server_http.py (the remote/connector variant). Bearer token
# claude.ai's Custom Connector must present. Generate the same way as UPLOAD_TOKEN.
MCP_CONNECTOR_TOKEN=
MCP_HTTP_PORT=8788

# Public hostname clients will send as the Host header (behind your reverse
# proxy), e.g. meetings.mgbeets.com. Required for server_http.py - the MCP
# SDK's DNS-rebinding protection rejects any Host/Origin not allowlisted here.
MCP_PUBLIC_HOST=
